# FinAdvisor — Environment Variables
# Copy to .env (backend/.env for the CLI) and replace every REPLACE_ME. Never commit .env.
# Missing required keys fail startup; see backend/src/config.py.

ENV_PROFILE=dev

# Database (DB_USER is the process role)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=finadvisor
DB_USER=REPLACE_ME
DB_PASSWORD=REPLACE_ME
DB_POOL_SIZE=5
DB_STATEMENT_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_S=10

# HTTP server port for `python -m src.entrypoint api` (docker compose fixes it to 8000 inside
# the container; use API_HOST_PORT below to move it on the host)
PORT=8000

# Docker Compose host ports, bound to 127.0.0.1. Change them when a port is taken or to run a
# second compose project (`-p`) side by side. Host processes (the `finadvisor` launcher) reach
# Postgres on POSTGRES_HOST_PORT, so keep DB_PORT equal to it in backend/.env.
POSTGRES_HOST_PORT=5432
KAFKA_HOST_PORT=9092
API_HOST_PORT=8000
FRONTEND_HOST_PORT=3000
# Backend the frontend dev server proxies /v1 and /api to, as seen from inside the compose network
VITE_DEV_PROXY_TARGET=http://api:8000

# Seconds `docker compose up --wait` waits for healthchecks before it gives up. Read from the
# shell environment by the launcher and tests/compose/check_compose.sh (not from this file).
# COMPOSE_WAIT_TIMEOUT_S=300

# LLM
ANTHROPIC_API_KEY=REPLACE_ME
ANTHROPIC_BASE_URL=https://api.anthropic.com
LLM_MODEL_ANSWER=claude-sonnet-5-5
LLM_MODEL_AUX=claude-haiku-5-5
LLM_MODEL_JUDGE=claude-haiku-5-5
LLM_MODEL_FALLBACK=claude-sonnet-4-6
LLM_FALLBACK_ENABLED=false
LLM_MAX_ITERATIONS=3
MODEL_RETIRE_WARN_DAYS=30

# Embeddings
VOYAGE_API_KEY=REPLACE_ME

# Langfuse (host and both keys are required only when LANGFUSE_ENABLED=true)
LANGFUSE_ENABLED=false
LANGFUSE_HOST=REPLACE_ME
LANGFUSE_PUBLIC_KEY=REPLACE_ME
LANGFUSE_SECRET_KEY=REPLACE_ME

# Readiness probe: seconds /readyz waits for the database check
READINESS_TIMEOUT_S=2.0
# Seconds /readyz reuses its last result, so a flood of calls cannot starve the pool
READINESS_CACHE_TTL_S=5.0

# Max requests per second to the eCFR versioner API (no vendor limit is published; arch figure)
CONNECTOR_RATE_RPS_ECFR=1.0

# Max requests per second to EUR-Lex CELLAR, SPARQL and REST (no vendor limit is published; arch figure)
CONNECTOR_RATE_RPS_EURLEX=1.0

# Max requests per second to the FCA Handbook API (no vendor limit is published; conservative)
FCA_API_RATE_LIMIT_RPS=1.0

# BigQuery erasure probe: the `bq` CLI binary, and the seconds one `bq query` may run before it is killed
BQ_BIN=bq
BQ_TIMEOUT_S=120

# PII redaction
PII_MODE=regex
GCP_PROJECT_ID=

# Auth (MVP only; removed in E1)
JWT_SECRET=REPLACE_ME

# Tests only (not Settings keys; `make test-integration` sets both). The integration tests build
# their database URL from the DB_* keys above. With REQUIRE_SERVICES=1 an unreachable Postgres or
# Kafka fails the tests; unset, they skip and name the missing service.
# REQUIRE_SERVICES=1
# KAFKA_BOOTSTRAP=localhost:9092
# Seconds the Kafka test waits for the broker (default 10)
# KAFKA_ADMIN_TIMEOUT_S=10
