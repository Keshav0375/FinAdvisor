# FinAdvisor — Environment Variables
# Copy to .env (backend/.env for the CLI) and replace every REPLACE_ME. Never commit .env.
# Missing required keys fail startup; see backend/src/config.py.

ENV_PROFILE=dev

# Database (DB_USER is the process role)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=finadvisor
DB_USER=REPLACE_ME
DB_PASSWORD=REPLACE_ME
DB_POOL_SIZE=5
DB_STATEMENT_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_S=10

# HTTP server port for `python -m src.entrypoint api`
PORT=8000

# LLM
ANTHROPIC_API_KEY=REPLACE_ME
ANTHROPIC_BASE_URL=https://api.anthropic.com
LLM_MODEL_ANSWER=claude-sonnet-5-5
LLM_MODEL_AUX=claude-haiku-5-5
LLM_MODEL_JUDGE=claude-haiku-5-5
LLM_MODEL_FALLBACK=claude-sonnet-4-6
LLM_FALLBACK_ENABLED=false
LLM_MAX_ITERATIONS=3
MODEL_RETIRE_WARN_DAYS=30

# Embeddings
VOYAGE_API_KEY=REPLACE_ME

# Langfuse (host and both keys are required only when LANGFUSE_ENABLED=true)
LANGFUSE_ENABLED=false
LANGFUSE_HOST=REPLACE_ME
LANGFUSE_PUBLIC_KEY=REPLACE_ME
LANGFUSE_SECRET_KEY=REPLACE_ME

# Readiness probe: seconds /readyz waits for the database check
READINESS_TIMEOUT_S=2.0
# Seconds /readyz reuses its last result, so a flood of calls cannot starve the pool
READINESS_CACHE_TTL_S=5.0

# PII redaction
PII_MODE=regex
GCP_PROJECT_ID=

# Auth (MVP only; removed in E1)
JWT_SECRET=REPLACE_ME
