# Demo values for `make test-integration` (the default ENV_FILE of that target). Nothing here is a
# secret: the stack lives for one test run on throwaway containers and these values only satisfy the
# required keys. They pass the placeholder check in backend/src/config.py (JWT_SECRET is over 32
# characters). Never put a real key in this file; use .env for real values.
# Host ports differ from the dev defaults so a running dev stack does not collide; DB_PORT must
# equal POSTGRES_HOST_PORT. KAFKA_HOST_PORT must not be 19092 or 29093: the broker already listens
# on those inside its container. Copy the file and pass ENV_FILE=<copy> to use other ports.

ENV_PROFILE=dev

DB_HOST=localhost
DB_PORT=15432
DB_NAME=finadvisor_integration
DB_USER=demo_user
DB_PASSWORD=demo-db-password
DB_POOL_SIZE=5
DB_STATEMENT_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_S=10

PORT=8000
POSTGRES_HOST_PORT=15432
KAFKA_HOST_PORT=29092
API_HOST_PORT=18000
FRONTEND_HOST_PORT=13000

ANTHROPIC_API_KEY=demo-anthropic-api-key
ANTHROPIC_BASE_URL=https://api.anthropic.com
VOYAGE_API_KEY=demo-voyage-api-key

LANGFUSE_ENABLED=false

PII_MODE=regex

JWT_SECRET=demo-jwt-secret-for-integration-0123456789
